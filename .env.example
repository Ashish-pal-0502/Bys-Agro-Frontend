# Copy to .env.local (local dev) or set these in your host's build settings.
# All NEXT_PUBLIC_* values are embedded in the browser bundle, so never put secrets here.

# Backend API base URL, including /api (used by the browser and by server-rendered pages)
NEXT_PUBLIC_SERVER=http://localhost:5055/api

# Public URL of this site (canonical URLs, Open Graph, sitemap)
NEXT_PUBLIC_CLIENT=http://localhost:3000

# Optional: override the sitemap host if it differs from NEXT_PUBLIC_CLIENT
# SITEMAP_BASE_URL=https://example.com

# Google sign-in (the backend must have the same client ID as GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Firebase web config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
